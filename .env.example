# Export these values into your shell before running the launcher.
# Titan intentionally does not automatically load credentials from a repository.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TITAN_WEBHOOK_SECRET=
# TITAN_WORKSPACE=/absolute/path/to/knowledge
# TITAN_STATE_DIR=/absolute/path/outside/knowledge
# PYTHON=python3
# Confluence: configure the shared Titan OAuth app on the operator's server.
# Register this exact callback in the Atlassian developer console.
# TITAN_CONFLUENCE_CLIENT_ID=
# TITAN_CONFLUENCE_CLIENT_SECRET=
# TITAN_CONFLUENCE_REDIRECT_URI=http://127.0.0.1:4310/api/v1/integrations/confluence/callback
